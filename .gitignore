# Python artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/

# Docker artifacts (don't commit layer cache or temp build files)
*.tar
docker-compose.override.yml

# Evidence files — generated at runtime (commit only the placeholder README)
evidence/*.txt
!evidence/.gitkeep

# OS / Editor artifacts
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace

# Secrets / credentials — should never be committed
*.pem
*.key
*.p12
*.pfx
*.env
secrets/

# Log files
*.log
logs/
